{
  "manifest_version": 3,
  "name": "Tiny Engineer Web Bridge",
  "version": "0.0.0",
  "description": "Lets your Tiny Engineer desk robot act out what ChatGPT, Claude and Open WebUI are doing. Local only, no tracking.",
  "homepage_url": "https://github.com/nmiller-engineering/tiny-engineer-web-bridge",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-engineer-web-bridge@nmiller-engineering.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Tiny Engineer Web Bridge",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src http:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "author": "nmiller-engineering",
  "short_name": "TE Web Bridge",
  "commands": {
    "toggle-bridge": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Turn the robot bridge on or off"
    }
  }
}
