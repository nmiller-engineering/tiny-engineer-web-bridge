{
  "manifest_version": 3,
  "name": "Tiny Engineer Web Bridge",
  "version": "0.0.0",
  "description": "Mirrors ChatGPT, Claude and Open WebUI activity as Tiny Engineer robot animations. Local only, no telemetry.",
  "homepage_url": "https://github.com/nmiller-engineering/tiny-engineer-web-bridge",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-engineer-web-bridge@nmiller-engineering.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Tiny Engineer Web Bridge",
    "default_popup": "popup/index.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src http:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
